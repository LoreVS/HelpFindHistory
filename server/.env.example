# Copy to .env and fill in values before starting the server.
# The server will refuse to start if JWT_SECRET is not set.

PORT=3001
JWT_SECRET=change-this-to-a-random-32+-character-string
JWT_EXPIRES_IN=7d

# Admin account seeded on first run. Change before first start.
ADMIN_EMAIL=admin@puzzleforge.local
ADMIN_PASSWORD=ChangeMe123!

DATABASE_PATH=./data/puzzle_forge.db
